# ---------------------------------------------------------------------------
# Postgres (required) — Supabase recommended
# Project Settings → Database → connection strings
# Enable extensions in SQL Editor:
#   CREATE EXTENSION IF NOT EXISTS vector;
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;
# See docs/10-setup.md
# ---------------------------------------------------------------------------
# App + migrations (Transaction pooler — works on WSL/IPv4)
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-....pooler.supabase.com:6543/postgres

# Optional. Avoid db.*.supabase.co from WSL (often IPv6-only → ENETUNREACH).
# Use Session pooler if you need a second URL.
# DATABASE_URL_DIRECT=

# ---------------------------------------------------------------------------
# OpenAI (embeddings for ranking; chat only on weak/empty catalog matches)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Admin (password session — not Supabase Auth / not Google users)
# Generate a secret: openssl rand -hex 32
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Google sign-in (Auth.js) — bookmarks /me; search stays public
# Google Cloud Console → OAuth client → authorized redirect:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR_DOMAIN/api/auth/callback/google
# Generate AUTH_SECRET: openssl rand -hex 32
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional aliases:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Local development only. Do NOT copy this line into a hosting dashboard.
# In production the live domain is resolved in src/lib/env.ts, and a localhost
# value here is ignored on purpose, because it silently breaks every social
# card and canonical URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SEARCH_CONFIDENCE_THRESHOLD=0.78

# Below this cosine similarity a vector match is noise rather than an
# answer, and is dropped instead of padding the page. Only affects the
# embedding path; keyword and seed results score on a different scale.
SEARCH_MIN_SIMILARITY=0.45

# Google Search Console, HTML-tag verification method. Paste only the content
# value of the meta tag Google shows, not the whole tag. Optional: leave it
# unset if the domain is verified by DNS instead, and no meta tag is rendered.
# GOOGLE_SITE_VERIFICATION=

# When the catalog has no good answer, the model may name real sites that are
# not in it yet. Those are stored as drafts and published the moment someone
# clicks through, so the catalog grows from real use. Set to "off" to answer
# only from what has already been curated.
SEARCH_DISCOVERY=on
# Days before the same query is allowed to pay for a fresh discovery run.
SEARCH_DISCOVERY_TTL_DAYS=7
